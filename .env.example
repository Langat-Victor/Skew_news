# SKEW news environment variables — canonical list (AGENTS.md §21)
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored;
# this template must only ever contain placeholders.
#
# Only NEXT_PUBLIC_* values reach browser code. Everything else is server-only
# and must never be imported by a component.
#
# Later features append their own blocks here (Supabase, Oxylabs, OpenAI,
# SKEW_ADMIN_SECRET, ANALYSIS_BATCH_SIZE). CRON_SECRET is injected by Vercel
# and must NOT be added to `.env.local` (§18).

# --- Clerk -------------------------------------------------------------------
# Keys from https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Server-only. Never expose to browser code, never log.
CLERK_SECRET_KEY=sk_test_xxx

# Where Clerk's prebuilt components are hosted in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to land after auth when the URL carries no redirect_url of its own.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Supabase ----------------------------------------------------------------
# Values from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS entirely — every table in this project denies anon
# and authenticated by default, so this key is the ONLY way the app reads or
# writes app data. Never expose to browser code, never log, never prefix with
# NEXT_PUBLIC_ (§21). Read in exactly one place: lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Oxylabs Web Scraper API -------------------------------------------------
# Credentials from the Oxylabs dashboard. Server-only: every scrape runs on the
# server (§21) — never a NEXT_PUBLIC_ alias, never logged.
OXY_WSA_USERNAME=your-oxylabs-username
OXY_WSA_PASSWORD=your-oxylabs-password

# --- Admin secret ------------------------------------------------------------
# Shared secret for the `x-SKEW-admin-secret` header on every action route
# (§15). Note the variable name and the header name differ. The guard also
# accepts the header name reused as a variable (`x-SKEW-admin-secret=...`) for
# local development, but THIS is the canonical name and the one to set on
# Vercel. Generate with `openssl rand -hex 32`. Server-only, never in a URL,
# never in browser code.
SKEW_ADMIN_SECRET=generate-a-long-random-string

# --- Google AI ---------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# --- PostHog -----------------------------------------------------------------
# Public client-side analytics configuration from PostHog Project Settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
